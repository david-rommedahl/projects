# Compose-level environment. Mirrors backend/.env.example, but the backend
# service overrides POSTGRES_HOST to "db" (the compose service name) so it
# reaches the Postgres container rather than localhost.
POSTGRES_HOST="db"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="<password>"
POSTGRES_DB="chat_service"

# LLM. The same OpenAI-compatible client serves two setups; pick one.
#
# 1) OpenAI directly (default): leave OPENAI_BASE_URL unset.
OPENAI_API_KEY="<openai-api-key>"
CHAT_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL=
#
# 2) Internal Azure AI Foundry deployment (e.g. GPT-5.3): point at the resource's
#    OpenAI v1 surface, use the Azure key, and set CHAT_MODEL to the *deployment*
#    name (the reference repo's GPT-5.4 deployment is named "gpt-5.4-1").
# OPENAI_BASE_URL="https://cv-manager-se-central-resource.services.ai.azure.com/openai/v1"
# OPENAI_API_KEY="<azure-api-key>"
# CHAT_MODEL="gpt-5.3-1"

# Logging. Accepts a level name (e.g. DEBUG) or a numeric level.
LOG_LEVEL="INFO"
