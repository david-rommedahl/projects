# PostgreSQL connection. POSTGRES_HOST defaults to "localhost" for running
# uvicorn on the host; docker-compose overrides it to "db".
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="<password>"
POSTGRES_DB="chat_service"

# OpenAI. The chat model defaults to gpt-4o-mini if unset.
OPENAI_API_KEY="<openai-api-key>"
CHAT_MODEL="gpt-4o-mini"

# Logging. Accepts a level name (e.g. DEBUG) or a numeric level.
LOG_LEVEL="INFO"
